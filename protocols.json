            "Assess core temperature trends"
        ],
        "actions": [
            "Move to well-ventilated quarantine pen",
            "Provide systemic antibiotics and NSAIDs per vet",
            "Ensure dry, draft-free bedding"
        ],
        "priority": "HIGH"
    },
    "RSV": {
        "exams": [
            "Check for mild cough",
            "Observe for clear nasal discharge",
            "Monitor for secondary infections"
        ],
        "actions": [
            "Reduce stress",
            "Ensure good ventilation",
            "Monitor temperature daily"
        ],
        "priority": "MODERATE"
    },
    "Johne's Disease": {
        "exams": [
            "Check for extreme wasting/weight loss",
            "Monitor chronic diarrhea",
            "Observe for lethargy"
        ],
        "actions": [
            "Separate from calves/kids immediately",
            "Consult on herd-testing strategy",
            "Strict hygiene"
        ],
        "priority": "MODERATE"
    },
    "Salmonellosis": {
