    "FMD": {
        "exams": [
            "Check for blisters/sores on mouth and tongue",
            "Examine hooves for heat or lameness",
            "Watch for excessive drooling"
        ],
        "actions": [
            "Total quarantine of the farm",
            "Notify local veterinary authorities immediately",
            "Disinfect all entry/exit points"
        ],
        "priority": "CRITICAL"
    },
    "Mastitis": {
        "exams": [
