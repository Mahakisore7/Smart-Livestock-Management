{
    "Foot and Mouth Disease": {
        "exams": [
            "Check for blisters/sores on mouth and tongue",
            "Examine hooves for heat or lameness",
            "Watch for excessive drooling"
        ],
        "actions": [
            "Total quarantine of the farm",
            "Notify local veterinary authorities immediately",
            "Disinfect all entry/exit points"
        ],
        "priority": "CRITICAL"
    },
    "Mastitis": {
        "exams": [
            "Check udder for heat and swelling",
            "Visual inspection of milk quality",
            "Check for reduced milk yield"
        ],
        "actions": [
            "Isolate from milking line",
            "Increase hygiene in bedding area",
            "Vet consultation for treatment"
        ],
        "priority": "HIGH"
    },
    "BRD": {
        "exams": [
            "Check for labored breathing",
            "Observe for eye discharge",
            "Listen for deep coughs"
        ],
        "actions": [
            "Immediate isolation",
            "Broad-spectrum supportive care",
            "Monitor herd-wide temperature"
        ],
        "priority": "CRITICAL"
    },
    "Bovine Pneumonia": {
        "exams": [
            "Listen for crackling sounds in lungs",
            "Check for flared nostrils",
            "Observe for extended neck while breathing"
        ],
        "actions": [
            "Provide immediate warmth and dry bedding",
            "Isolate from drafts",
            "Strict rest"
        ],
        "priority": "CRITICAL"
    },
    "RSV": {
        "exams": [
            "Check for mild cough",
            "Observe for clear nasal discharge",
            "Monitor for secondary infections"
        ],
        "actions": [
            "Reduce stress",
            "Ensure good ventilation",
            "Monitor temperature daily"
        ],
        "priority": "MODERATE"
    },
    "Johne's Disease": {
        "exams": [
            "Check for extreme wasting/weight loss",
            "Monitor chronic diarrhea",
            "Observe for lethargy"
        ],
        "actions": [
            "Separate from calves immediately",
            "Consult on herd-testing strategy",
            "Strict hygiene"
        ],
        "priority": "MODERATE"
    },
    "Salmonellosis": {
        "exams": [
            "Check for foul-smelling diarrhea with blood/mucus",
            "Monitor for rapid dehydration",
            "Check for sudden drop in milk"
        ],
        "actions": [
            "Intensive electrolyte therapy",
            "Disinfect pens with chlorine-based cleaners",
            "Isolate away from water supplies"
        ],
        "priority": "HIGH"
    },
    "Bovine Viral Diarrhea": {
        "exams": [
            "Check for ulcers in mouth/muzzle",
            "Monitor for fever and mild diarrhea",
            "Observe for nasal/eye discharge"
        ],
        "actions": [
            "Test herd for 'persistently infected' animals",
            "Vaccinate healthy animals",
            "Isolate sick individuals"
        ],
        "priority": "HIGH"
    },
    "Cryptosporidiosis": {
        "exams": [
            "Check for yellowish/watery diarrhea",
            "Monitor for dehydration in calves",
            "Observe for straining"
        ],
        "actions": [
            "Strict hygiene in calf pens",
            "Provide oral rehydration therapy",
            "Steam-clean equipment"
        ],
        "priority": "HIGH"
    },
    "Bovine Leukemia Virus": {
        "exams": [
            "Check for enlarged lymph nodes (neck/flank)",
            "Observe for weight loss",
            "Check for bulging eyes"
        ],
        "actions": [
            "Use single-use needles for all injections",
            "Control biting insects",
            "Consult on testing/culling"
        ],
        "priority": "MODERATE"
    },
    "Coccidiosis": {
        "exams": [
            "Check for watery/bloody feces",
            "Monitor for reduced growth",
            "Observe for rough coat"
        ],
        "actions": [
            "Clean water troughs frequently",
            "Provide dry areas to rest",
            "Isolate clinical cases"
        ],
        "priority": "HIGH"
    },
    "Tuberculosis": {
        "exams": [
            "Monitor for persistent dry cough",
            "Check for swollen lymph nodes",
            "Observe for progressive weakness"
        ],
        "actions": [
            "Restrict all animal movement",
            "Quarantine the farm",
            "Consult authorities"
        ],
        "priority": "CRITICAL"
    },
    "Bovine Influenza": {
        "exams": [
            "Check for sudden high fever",
            "Observe for clear nasal discharge",
            "Monitor for sudden drop in milk yield"
        ],
        "actions": [
            "Provide dust-free bedding",
            "Ensure plenty of fresh water",
            "Monitor for secondary pneumonia"
        ],
        "priority": "HIGH"
    },
    "Healthy": {
        "exams": [
            "General observation of coat and behavior"
        ],
        "actions": [
            "Maintain normal feeding and monitoring"
        ],
        "priority": "LOW"
    }
}