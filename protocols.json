        ],
        "actions": [
            "Provide immediate warmth and dry bedding",
            "Isolate from drafts",
            "Strict rest"
        ],
        "priority": "CRITICAL"
    },
    "Pneumonia": {
        "exams": [
            "Thoracic auscultation for crackling/wheezing",
